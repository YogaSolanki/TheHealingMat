{
  "name": "the-healing-mat",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev:backend": "npm run start:dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:admin": "npm run dev --prefix admin",
    "dev": "concurrently -n api,web,admin -c green,magenta,cyan \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:admin\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
