NODE_ENV=development
PORT=4000

# Local Postgres (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=healingmat
DB_PASSWORD=healingmat
DB_NAME=healingmat

# Render / hosted Postgres — if set, this overrides DB_HOST / DB_* above
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# DB_SSL=true
# First deploy only (creates tables). Set back to false after first successful boot.
# DB_SYNCHRONIZE=true

# Comma-separated origins allowed (no trailing slash). Include every deployed host.
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# Production example:
# FRONTEND_URL=https://your-frontend.vercel.app
# ADMIN_URL=https://the-healing-mat-543c-zeta.vercel.app
API_PUBLIC_URL=http://localhost:4000/api

JWT_SECRET=change-me-in-development

# Optional Google OAuth (Continue with Google)
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Contact + corporate enquiry forms → email via Resend (https://resend.com)
# Free tier tip: verify a domain, or use onboarding@resend.dev and send only to your Resend account email.
RESEND_API_KEY=
# Must use an address on your verified Resend domain
RESEND_FROM_EMAIL=The Healing Mat <noreply@thehealingmat.yoga>
CONTACT_TO_EMAIL=solankipr@gmail.com

# Temporary default WhatsApp OTP while AiSensy is paused (billing / display name).
# When true: India mobile OTP request succeeds without WhatsApp send; verify with 1111.
# Set false to resume real AiSensy WhatsApp OTP delivery.
WHATSAPP_OTP_DEFAULT_ENABLED=false
WHATSAPP_OTP_DEFAULT_CODE=1111

# India WhatsApp OTP via AiSensy (signup / login / password reset for region=india)
# Dashboard: https://app.aisensy.com/  → Manage → API Key
# Campaigns → +Launch → API Campaign (must be Live, Authentication template)
AISENSY_API_KEY=
AISENSY_CAMPAIGN_NAME=
# Required by AiSensy when we don't have the member's name yet
AISENSY_DEFAULT_USER_NAME=Member
AISENSY_SOURCE=The Healing Mat
# Auth templates need OTP in the Copy Code button as well as the body
AISENSY_OTP_COPY_CODE_BUTTON=true
# Almost always 1 (the OTP). Set 2 only if Test Campaign lists two params.
AISENSY_OTP_PARAM_COUNT=1

# MSG91 auth key is still used for trial welcome / reminder WhatsApp templates below.
# MSG91_OTP_* is unused now that login OTP goes through AiSensy.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_API_MODE=otp
MSG91_OTP_VAR=otp

# WhatsApp (MSG91) — free-trial welcome + pre-start reminder
# Integrated WhatsApp Business number digits (no +)
MSG91_WHATSAPP_NUMBER=
MSG91_WHATSAPP_NAMESPACE=
MSG91_WHATSAPP_LANGUAGE=en
# Approved template names (body vars: welcome = name, start, end, memberAreaUrl;
# reminder = name, start, 7AM, 7PM, memberAreaUrl)
MSG91_WHATSAPP_TEMPLATE_WELCOME=
MSG91_WHATSAPP_TEMPLATE_REMINDER=
# Optional geo overrides for Membership + Free Trial region detection
# FORCE_REGION=india|outside_india  (always win — useful for staging)
# DEFAULT_REGION=india              (used when IP/CDN geo is unavailable)
FORCE_REGION=
DEFAULT_REGION=india

# Creates/updates the admin account on API boot (set the same values on Render)
ADMIN_SEED_EMAIL=admin@thehealingmat.local
ADMIN_SEED_PASSWORD=change-me-admin

# Razorpay Standard Checkout (test keys from the Razorpay Dashboard)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional seed for admin-managed live session URL (also settable in Admin → Settings)
# LIVE_SESSION_URL=https://zoom.us/j/your-meeting-id
