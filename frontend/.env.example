# Browser API base URL. Defaults to /api (proxied to the backend via next.config rewrites).
NEXT_PUBLIC_API_URL=/api

# Used by Next.js rewrites in development (optional).
BACKEND_URL=http://localhost:4000

# Public Razorpay Key ID only — never put RAZORPAY_KEY_SECRET in the frontend.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
